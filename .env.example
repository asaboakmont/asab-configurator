# Internal designer/admin access. Configure strong, distinct values in deployment.
ASAB_INTERNAL_SESSION_SECRET=replace-with-a-long-random-secret
ASAB_ADMIN_PASSWORD=replace-with-a-strong-admin-password
ASAB_DESIGNER_PASSWORD=replace-with-a-strong-designer-password

# The GLB UI also requires an authenticated internal session.
NEXT_PUBLIC_ENABLE_GLB_EXPORT=false
